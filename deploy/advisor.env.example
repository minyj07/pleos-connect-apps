# Copy to advisor.env (gitignored: *.env) next to docker-compose.yml and fill in. See docs/ADVISOR_SERVER.md.

# data.go.kr "Decoding" key for 한국환경공단_전기자동차 충전소 정보 (15076352). Use the production-account
# key for the real service: the development account allows 10,000 calls a day.
DATA_GO_KR_SERVICE_KEY=
DAILY_CALL_BUDGET=10000

# Newest app release on the Pleos App Market: cars with an older build are offered the update.
# Raise it after the market approved a release; leave empty to never prompt.
APP_LATEST_VERSION_CODE=
APP_LATEST_VERSION_NAME=

# Set by the image: HOST=0.0.0.0, PORT=8080, DATA_DIR=/app/data, TRUST_PROXY=1 (Caddy in front).
# FAKE_SOURCE=1 serves the bundled synthetic stations instead (tests only, never in production).
